# ==============================================================================
# Sympose Environment Configuration Template
# ==============================================================================

# LLM API Keys
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant...
OPENAI_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-...

# Default Sub-Agent Worker Model (Fallback if not specified in task or skill)
# Format: openrouter/<provider>/<model>, gemini/<model>, anthropic/<model>, etc.
DEFAULT_MODEL=gemini/gemini-3.5-flash-lite

# Local Ollama Backend (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Slack Integration (Socket Mode)
# Samantha (Primary / Default Bot)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-1-...

# Grace Hopper (Dedicated Bot - Optional)
SLACK_GRACE_BOT_TOKEN=xoxb-...
SLACK_GRACE_APP_TOKEN=xapp-1-...

# Anaïs Nin (Dedicated Bot - Optional)
# SLACK_ANAIS_BOT_TOKEN=xoxb-...
# SLACK_ANAIS_APP_TOKEN=xapp-1-...

# (Optional) Master Notes / Obsidian Vault Directory
# If unset, Sympose operates purely on local profiles/_memory.md files
MASTER_VAULT_PATH=/Users/username/Obsidian/MyVault

# Vault Search Mode: direct (Pure Python) | sqlite_fts (Ranked BM25) | semantic (Local Vector)
VAULT_SEARCH_MODE=direct
