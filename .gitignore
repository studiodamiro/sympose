# Secrets & Environment
.env
*.env
.env.*
!.env.example

# Self-signed dashboard TLS cert/key, generated per-workspace (ADR-064.2)
.certs/

# sqlite_fts vault search index, generated per-workspace (ADR-070.5)
.vault_index/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*

# Logs & Temporary Files
*.log
scratch/
.history
.history/
artifacts/*.html
artifacts/*.svg

# Private User Data & Live Working Memory (Local Sovereignty)
profiles/*_memory.md
profiles/_shared_memory.md
profiles/user_profile.md
profiles/_archived/
profiles/samantha_memory.md
profiles/grace_memory.md
profiles/aurelius_memory.md
sessions/
*.jsonl
!*.example

# Persona manifests & souls — only Samantha ships as the starter seed (ADR-046).
# Every other persona (Grace, Anaïs, anything you create) is your own local
# customization, not product content — never re-track these.
profiles/*.yaml
profiles/*_soul.md
!profiles/samantha.yaml
!profiles/samantha_soul.md

# AI tooling — never committed
.agents/
CLAUDE.md
.claude/
.cursor/
