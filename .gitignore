# AI assistant & editor tooling — never committed
.agents/
.claude/
.gemini/
.cursor/
CLAUDE.md
GEMINI.md
.vscode/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Local env / secrets
.env

# App-wide settings (active vault, and future knobs like compaction
# default / Slack allowlist) — backend-written local state, not source.
settings.json

# Personas: Samantha ships as the only default persona; any other profile
# is a personal customization and stays local-only, never committed.
profiles/*.yaml
!profiles/samantha.yaml
profiles/*_soul.md
!profiles/samantha_soul.md

# Memory is never a shipped default, Samantha included: it's generated at
# onboarding / agent-creation time and accumulates real personal content
# from actual use. No `*_memory.md` file is ever committed, regardless of
# handle — unlike the soul baseline above, there is no template variant.
profiles/*_memory.md

# Local-only progress tracker — a working status file for keeping in sync
# during development, not a product doc; would just be commit noise every
# time a checkbox flips.
docs/CHECKLIST.md

# macOS
.DS_Store
