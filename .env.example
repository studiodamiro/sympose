# ==============================================================================
# 🏛️ Sympose Environment Configuration Template
# ==============================================================================

# LLM API Keys
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant...
OPENAI_API_KEY=

# Local Ollama Backend (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Slack Integration (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-1-...

# (Optional) Master Notes / Obsidian Vault Directory
# If unset, Sympose operates purely on local profiles/_memory.md files
MASTER_VAULT_PATH=/Users/username/Obsidian/MyVault

# Vault Search Mode: direct (Pure Python) | sqlite_fts (Ranked BM25) | semantic (Local Vector)
VAULT_SEARCH_MODE=direct
