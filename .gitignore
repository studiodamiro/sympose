# AI assistant & editor tooling — never committed
.agents/
.claude/
.gemini/
.cursor/
CLAUDE.md
GEMINI.md
.vscode/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Local env / secrets
.env

# App-wide settings (active vault, and future knobs like compaction
# default / Slack allowlist) — backend-written local state, not source.
settings.json

# Chat session logs — per-conversation state generated at runtime, not source.
# Live in profiles/<handle>/sessions/ (ignored above); this top-level dir is
# only the fallback when no profiles/ directory exists at all.
sessions/

# The cache of passage vectors for meaning-based search (docs/decisions/027), beside settings.json;
# rebuilt whenever it is missing.
embedding_cache.sqlite*

# Recaps of those sessions (docs/decisions/023): the same, in profiles/<handle>/recaps/
# or, in that fallback, here.
recaps/

# Personas (docs/decisions/011): one directory per persona under profiles/.
# Samantha ships as the only default persona — her persona.yaml and soul.md
# are the committed baseline; every other persona is a personal
# customization and stays local-only. Everything else under profiles/ is
# ignored by default, which is what keeps a persona's memory.md and
# sessions/ from ever being committed, Samantha's included (ADR 001) —
# unlike soul, memory has no template variant. Whether Samantha's
# expertise.md ships is decided when expertise is built.
profiles/*
!profiles/samantha/
profiles/samantha/*
!profiles/samantha/persona.yaml
!profiles/samantha/soul.md

# Local-only progress tracker — a working status file for keeping in sync
# during development, not a product doc; would just be commit noise every
# time a checkbox flips.
docs/CHECKLIST.md

# macOS
.DS_Store
