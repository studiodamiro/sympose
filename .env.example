VAULT_PATHS=/Users/username/Obsidian/MyVault
# Multiple vaults: comma-separate them. The first one is active by default;
# switching in the dashboard persists the choice to SYMPOSE_SETTINGS_PATH.
# VAULT_PATHS=/Users/username/Obsidian/MyVault,/Users/username/Obsidian/Work

# SYMPOSE_PROFILES_DIR defaults to ./profiles
# SYMPOSE_SETTINGS_PATH defaults to ./settings.json
